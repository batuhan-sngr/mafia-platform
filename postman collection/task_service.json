  },
  "item": [
    {
      "name": "Generate Tasks",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"game_id\": \"game_001\",\n  \"player_ids\": [\"player_123\", \"player_456\"],\n  \"day_number\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/generate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "tasks",
            "generate"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Complete Task",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"player_id\": \"player_123\",\n  \"used_items\": [\"garlic\"],\n  \"completion_notes\": \"Completed task successfully\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}/complete",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "tasks",
            "{{taskId}}",
            "complete"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Player Tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/player/{{playerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "tasks",
            "player",
            "{{playerId}}"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "playerId",
      "value": "player_123"
    },
    {
      "key": "taskId",
      "value": "your_task_id_here"
    }
