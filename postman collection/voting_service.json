{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
    "name": "Voting Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Voting Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"game_id\": \"{{gameId}}\",\n  \"eligible_voters\": [\"player_1\", \"player_2\", \"player_3\"],\n  \"eligible_targets\": [\"player_1\", \"player_2\", \"player_3\"],\n  \"duration_minutes\": 5,\n  \"day_number\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/voting/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "voting",
            "sessions"
          ]
        },
        "description": "Starts a new voting session for a specific game."
      },
      "response": []
    },
    {
      "name": "Cast Vote",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"voter_id\": \"player_1\",\n  \"target_player_id\": \"player_3\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/voting/vote",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "voting",
            "vote"
          ]
        },
        "description": "Casts a single vote within an active voting session. Use the `sessionId` from the 'Create Voting Session' response."
      },
      "response": []
    },
    {
      "name": "Get Current Session",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/voting/sessions/{{gameId}}/current",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "voting",
            "sessions",
            "{{gameId}}",
            "current"
          ]
        },
        "description": "Retrieves the currently active voting session for a given game."
      },
      "response": []
    },
    {
      "name": "End Voting Session",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/voting/sessions/{{sessionId}}/end",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "voting",
            "sessions",
            "{{sessionId}}",
            "end"
          ]
        },
        "description": "Manually ends a voting session and calculates the result to determine the eliminated player."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "gameId",
      "value": "game_test_001"
    },
    {
      "key": "sessionId",
      "value": "your_session_id_here"
    }
  ]
}